{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Запуск сервера",
      "program": "${workspaceFolder}/server.js",
      "env": {
        "PORT": "3000",
        "ADMIN_PASSWORD": "admin",
        "DB_PATH": "${workspaceFolder}/data.db"
      },
      "console": "integratedTerminal",
      "restart": true,
      "runtimeExecutable": "node"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Запуск с .env",
      "program": "${workspaceFolder}/server.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true
    }
  ]
}